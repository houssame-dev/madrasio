{
  "name": "madrasio-production-backup-scheduler",
  "main": "worker.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "preview_urls": false,
  // Activation is a separately authorized provider gate. No active Cron Trigger.
  "triggers": { "crons": [] },
  "vars": {
    "GITHUB_APP_ID": "REQUIRES_REVIEW",
    "GITHUB_INSTALLATION_ID": "REQUIRES_REVIEW",
    "GITHUB_OWNER": "REQUIRES_REVIEW",
    "GITHUB_REPOSITORY": "REQUIRES_REVIEW",
    "GITHUB_WORKFLOW": "backup-production.yml",
    "BACKUP_CANDIDATE_SHA": "REQUIRES_ACCEPTED_IMPLEMENTATION_SHA",
  },
}

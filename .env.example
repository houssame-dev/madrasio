# =============================================================================
# Environment Configuration
# School Management System — V1 Foundation
# =============================================================================
#
# Copy this file to `.env.local` for local development.
#
# Two scopes exist:
#   - Client-safe (NEXT_PUBLIC_*): inlined by Next.js into the browser bundle.
#   - Server-only: never exposed to the client. Server modules reference them
#     via `lib/config/env.ts` which validates the schema at startup.
#
# Required for the V1 foundation:
#   NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#   SUPABASE_URL, DATABASE_URL
#
# Everything else is optional and may be left blank (empty values are treated
# as "not configured" — they will NOT fail the build).
#
# Never commit real secrets. Never expose server-only values to client code.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Dedicated server-only machine credential for /api/internal/jobs/*.
# Task 046 stores the deployed value in Vercel and Supabase Vault.
CRON_SECRET=

# -----------------------------------------------------------------------------
# Client-safe (browser) — MUST use NEXT_PUBLIC_ prefix
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Required for the server-only Teacher/Parent account invitation endpoints.
# MUST NEVER be exposed to client code.
SUPABASE_SECRET_KEY=
# Legacy JWT-based Supabase API keys are retired and are not accepted as fallbacks.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Runtime only. Hosted staging/production use the Supabase transaction pooler.
# The application never runs migrations through this connection.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Migration/CI only. Hosted staging/production use the direct PostgreSQL
# connection when reachable, otherwise the Supabase SESSION pooler. Never use
# the transaction pooler here. Drizzle falls back to DATABASE_URL when this is
# blank/unset so local development remains a one-URL workflow.
MIGRATION_DATABASE_URL=
# Optional trusted provider CA PEM (actual newlines or escaped \n). Remote connections
# always verify certificates/hostnames. Configure this for runtime AND migration
# environments if the provider chain is not trusted by Node. Never disable verification.
# Before pushing Task 047: stage and validate this CA in Vercel and the GitHub
# staging environment variable of the same name for BOTH pooler endpoints.
DATABASE_SSL_CA=

# -----------------------------------------------------------------------------
# Explicit STAGING deployment/infrastructure operations — never browser runtime
# -----------------------------------------------------------------------------
DEPLOY_TARGET_ENV=
DEPLOY_EXPECTED_PROJECT_REF=
STAGING_APP_ORIGIN=
# Required only for the guarded one-time/idempotent Supabase Cron configuration.
RUN_STAGING_CRON_CONFIGURATION=

# Explicit Production release/infrastructure operations. Production values must
# be distinct from STAGING. The project ref is intentionally not committed.
PRODUCTION_APP_ORIGIN=
PRODUCTION_EXPECTED_PROJECT_REF=
PRODUCTION_DEPLOY_CONFIRMATION=
RUN_PRODUCTION_CRON_CONFIGURATION=

# -----------------------------------------------------------------------------
# Explicit operator provisioning — loaded only by the Task 042 CLI commands
# -----------------------------------------------------------------------------
# These variables are NOT part of normal Next.js runtime configuration.
# Keep real values only in ignored local/operator configuration. Passwords must
# never be passed as command-line arguments.
BOOTSTRAP_TARGET_ENV=
BOOTSTRAP_EXPECTED_PROJECT_REF=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SCHOOL_NAME=
BOOTSTRAP_SCHOOL_TIMEZONE=

# Production first-tenant creation remains blocked until backup/recovery and an
# isolated restore rehearsal are accepted. Both phrases must match exactly.
BOOTSTRAP_PRODUCTION_CONFIRMATION=
PRODUCTION_CUSTOMER_DATA_BACKUP_CONFIRMED=

# STAGING demo identities only. These are test fixtures, not the invitation
# workflow. They must never be configured for Production.
STAGING_TEACHER_EMAIL=
STAGING_TEACHER_PASSWORD=
STAGING_PARENT_EMAIL=
STAGING_PARENT_PASSWORD=

# -----------------------------------------------------------------------------
# Cloudflare R2 (file storage) — server-only
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# -----------------------------------------------------------------------------
# Observability — server-only
# -----------------------------------------------------------------------------
SENTRY_DSN=

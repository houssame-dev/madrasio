# =============================================================================
# Environment Configuration
# School Management System — V1 Foundation
# =============================================================================
#
# Copy this file to `.env.local` for local development.
#
# Two scopes exist:
#   - Client-safe (NEXT_PUBLIC_*): inlined by Next.js into the browser bundle.
#   - Server-only: never exposed to the client. Server modules reference them
#     via `lib/config/env.ts` which validates the schema at startup.
#
# Never commit real secrets. Never expose server-only values to client code.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Client-safe (browser) — MUST use NEXT_PUBLIC_ prefix
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Server-only Supabase
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
# Optional in V1. Required later for server-side admin operations.
# MUST NEVER be exposed to client code.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Database (Supabase Postgres / direct connection)
# -----------------------------------------------------------------------------
# Use the pooled connection URL for serverless runtime (Vercel, etc.).
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# -----------------------------------------------------------------------------
# Cloudflare R2 (file storage) — server-only
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# -----------------------------------------------------------------------------
# Observability — server-only
# -----------------------------------------------------------------------------
SENTRY_DSN=
